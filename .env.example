# Which LLM provider to use: gemini | claude | openai
LLM_PROVIDER=gemini

# How much the AI may expand short content:
#   strict   = no expansion, extraction-only
#   standard = light expansion (industry context, transitions) without inventing facts
EXPANSION_MODE=standard

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Server
# Must match frontend/vite.config.ts: the /api proxy targets 8788, and vite
# runs on 5179 with strictPort.
PORT=8788
CORS_ORIGIN=http://localhost:5179

# Durable run store: SQLite database + rendered PDF artifacts.
# Relative paths resolve from backend/ (the cwd under `pnpm dev:backend`).
DATA_DIR=./data

# Set false to run the API without the background run worker.
WORKER_ENABLED=true

# Gates automatic final approval. Leave false until Phase 3 ships and validates
# real rendered-output QA — pre-render heuristics must not finalize a document.
RENDER_QA_ENABLED=false
