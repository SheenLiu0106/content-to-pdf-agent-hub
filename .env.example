# Which LLM provider to use: gemini | claude | openai
LLM_PROVIDER=gemini

# How much the AI may expand short content:
#   strict   = no expansion, extraction-only
#   standard = light expansion (industry context, transitions) without inventing facts
EXPANSION_MODE=standard

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173
