# Which LLM provider to use: claude | openai | gemini
LLM_PROVIDER=claude

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Server
PORT=8787
CORS_ORIGIN=http://localhost:5173
